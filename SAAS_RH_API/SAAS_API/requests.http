### Agent : suite de conversation
POST {{base}}/api/agent/chat
Content-Type: application/json

{
  "messages": [
    { "role": "user", "content": "Quels créneaux sont libres le 2026-10-16 ?" },
    { "role": "assistant", "content": "Le 2026-10-16, les créneaux libres sont 10:00 et 15:00." },
    { "role": "user", "content": "Réserve 15:00 pour Sophie Martin (sophie.m@email.com)" }
  ]
}

